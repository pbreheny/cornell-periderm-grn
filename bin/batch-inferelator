#!/usr/bin/env Rscript
r"(Usage: batch-inferelator [options] <type> <data> <prior> <x>

Submit multiple inferelator jobs via qbatch. All arguments can have commas, which loop.

Arguments:
  type       bbsr or enet [string]
  data       Which data to use? 'fns25' = farrel none shield, 25% filter. import_expr() [string]
  prior      Which prior to use? See import_prior() [string]
  x          Either alpha (enet) or strength (bbsr) [number]

Options:
  --ppj=<n>  Number of processors per job [default: 1]
)" -> doc
suppressMessages(library(docopt))
opt <- docopt(doc)

# Create qbatch job list
if (file.exists('qbatch-jobs.txt')) invisible(file.remove('qbatch-jobs.txt'))
for (i in stringr::str_split(opt$type, ',')[[1]]) {
  for (j in stringr::str_split(opt$data, ',')[[1]]) {
    for (k in stringr::str_split(opt$prior, ',')[[1]]) {
      for (l in stringr::str_split(opt$x, ',')[[1]]) {
        cat('bin/fit-inferelator', i, j, k, l, '\n', file='qbatch-jobs.txt', append=TRUE)
      }
    }
  }
}


# Run qbatch
system(paste0('qbatch -q BIOSTAT --ppj ', opt$ppj, ' qbatch-jobs.txt'))
