Bootstrap: docker
From: bioconductor/r-ver:3.23

%post
    # Install system dependencies
    apt-get update && apt-get install -y \
        git

    # R packages
    Rscript -e 'install.packages(c(
        "ashr",
        "data.table",
        "docopt",
        "doParallel",
        "doRNG",
        "forcats",
        "glmnet",
        "glue",
        "ggplot2",
        "ggraph",
        "igraph",
        "ncvreg",
        "patchwork",
        "readxl",
        "shadowtext",
        "stringr",
        "BiocManager",
        "MetBrewer",
        "R.utils"
        ), repos = "https://cloud.r-project.org"
    )'
    Rscript -e 'BiocManager::install(c(
        "AnnotationDbi",
        "DESeq2",
        "GENIE3"
    ))'

    # Python packages
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install docopt
    /opt/venv/bin/pip install "git+https://github.com/flatironinstitute/inferelator"

%environment
    export PATH=/opt/venv/bin:$PATH
